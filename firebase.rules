rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /giftProgress/{day} {
      function validDay() {
        return day.matches('^(?:[1-9]|1[0-9]|2[0-5])$');
      }
      function progressOnly(data) {
        return data.keys().hasOnly(['openedAt', 'letterOpenedAt', 'termsAccepted', 'reactionPhoto', 'reactionCapturedAt', 'christmasTreeImage', 'christmasTreeUpdatedAt', 'snowglobeImage', 'snowglobeImageUpdatedAt', 'fireworksActivated', 'boomboxActivated', 'mariahAtticActivated']);
      }
      function validReaction(data) {
        return (!('reactionPhoto' in data) && !('reactionCapturedAt' in data))
          || (data.reactionPhoto is string
            && data.reactionPhoto.size() <= 800000
            && data.reactionCapturedAt is timestamp);
      }
      function validChristmasTree(data) {
        return (!('christmasTreeImage' in data) && !('christmasTreeUpdatedAt' in data))
          || (day == '23'
            && data.christmasTreeImage is string
            && data.christmasTreeImage.size() <= 800000
            && data.christmasTreeUpdatedAt is timestamp);
      }
      function validSnowglobeImage(data) {
        return (!('snowglobeImage' in data) && !('snowglobeImageUpdatedAt' in data))
          || (day == '16'
            && data.snowglobeImage is string
            && data.snowglobeImage.size() <= 800000
            && data.snowglobeImageUpdatedAt is timestamp);
      }
      function validFeatureActivations(data) {
        return (!('fireworksActivated' in data)
            || (day == '25' && data.fireworksActivated is bool && data.fireworksActivated == true))
          && (!('boomboxActivated' in data)
            || (day == '1' && data.boomboxActivated is bool && data.boomboxActivated == true))
          && (!('mariahAtticActivated' in data)
            || (day == '25' && data.mariahAtticActivated is bool && data.mariahAtticActivated == true));
      }
      function validTermsAcceptance(data) {
        return !('termsAccepted' in data)
          || (day == '1' && data.termsAccepted is bool && data.termsAccepted == true);
      }
      function validCreate() {
        return progressOnly(request.resource.data)
          && request.resource.data.keys().hasAny(['openedAt', 'letterOpenedAt', 'termsAccepted', 'reactionPhoto', 'christmasTreeImage', 'snowglobeImage', 'fireworksActivated', 'boomboxActivated', 'mariahAtticActivated'])
          && (!('openedAt' in request.resource.data) || request.resource.data.openedAt is timestamp)
          && (!('letterOpenedAt' in request.resource.data) || request.resource.data.letterOpenedAt is timestamp)
          && validReaction(request.resource.data)
          && validChristmasTree(request.resource.data)
          && validSnowglobeImage(request.resource.data)
          && validFeatureActivations(request.resource.data)
          && validTermsAcceptance(request.resource.data);
      }
      function validUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return progressOnly(request.resource.data)
          && changed.hasOnly(['openedAt', 'letterOpenedAt', 'termsAccepted', 'reactionPhoto', 'reactionCapturedAt', 'christmasTreeImage', 'christmasTreeUpdatedAt', 'snowglobeImage', 'snowglobeImageUpdatedAt', 'fireworksActivated', 'boomboxActivated', 'mariahAtticActivated'])
          && (!changed.hasAny(['openedAt'])
            || (request.resource.data.openedAt is timestamp
              && (!('openedAt' in resource.data) || resource.data.openedAt == null)))
          && (!changed.hasAny(['letterOpenedAt'])
            || (request.resource.data.letterOpenedAt is timestamp
              && (!('letterOpenedAt' in resource.data) || resource.data.letterOpenedAt == null)))
          && (!changed.hasAny(['reactionPhoto', 'reactionCapturedAt'])
            || changed.hasAll(['reactionPhoto', 'reactionCapturedAt']))
          && (!changed.hasAny(['christmasTreeImage', 'christmasTreeUpdatedAt'])
            || changed.hasAll(['christmasTreeImage', 'christmasTreeUpdatedAt']))
          && (!changed.hasAny(['snowglobeImage', 'snowglobeImageUpdatedAt'])
            || changed.hasAll(['snowglobeImage', 'snowglobeImageUpdatedAt']))
          && validReaction(request.resource.data)
          && validChristmasTree(request.resource.data)
          && validSnowglobeImage(request.resource.data)
          && validFeatureActivations(request.resource.data)
          && validTermsAcceptance(request.resource.data);
      }

      // The client reads the giftProgress collection on startup so feature
      // activations and saved gift media can synchronize across devices.
      allow read: if request.auth != null;
      allow create: if request.auth != null && validDay() && validCreate();
      allow update: if request.auth != null && validDay() && validUpdate();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
